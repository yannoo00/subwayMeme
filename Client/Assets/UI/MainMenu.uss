/* === 컬러 토큰 (참고용 주석) ===
   bg-darkest:      rgb(14, 16, 20)
   bg-panel:        rgb(22, 26, 32)     - 다이얼로그
   bg-surface:      rgb(32, 38, 46)     - 버튼/면
   bg-surface-hov:  rgb(44, 52, 62)
   bg-surface-act:  rgb(26, 30, 36)
   bg-inset:        rgb(18, 22, 28)     - 스크롤/입력 트랙
   border-faint:    rgba(255, 255, 255, 0.06)
   border:          rgba(255, 255, 255, 0.1)
   border-strong:   rgba(255, 255, 255, 0.18)
   accent:          rgb(180, 195, 215)
   text:            rgb(228, 230, 234)
   text-dim:        rgba(170, 180, 195, 0.7)
   text-muted:      rgba(120, 130, 145, 0.5)
   gold:            rgb(218, 180, 110)
   danger-fg:       rgb(220, 150, 150)
*/


/* === 풀스크린 패널 === */

.full-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(14, 16, 20);
    align-items: center;
    justify-content: center;
    flex-direction: column;
}


/* === 게임 타이틀 === */

.game-title {
    color: rgb(228, 230, 234);
    font-size: 56px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    margin-bottom: 56px;
}


/* === 다이얼로그 박스 === */

.dialog-box {
    background-color: rgb(22, 26, 32);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 28px 32px;
    min-width: 380px;
    align-items: stretch;
}

.dialog-box--wide {
    min-width: 560px;
}

.dialog-title {
    color: rgb(228, 230, 234);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}


/* === 버튼 (메뉴 공통) === */

.menu-button {
    height: 44px;
    min-width: 220px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(228, 230, 234);
    background-color: rgb(32, 38, 46);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    margin: 4px 0;
    padding: 0 22px;
    transition-duration: 80ms;
    transition-property: background-color, border-color;
}

.menu-button:hover {
    background-color: rgb(44, 52, 62);
    border-color: rgba(180, 195, 215, 0.45);
}

.menu-button:active {
    background-color: rgb(26, 30, 36);
}

.menu-button:disabled {
    background-color: rgb(24, 28, 34);
    border-color: rgba(255, 255, 255, 0.05);
    color: rgba(120, 130, 145, 0.4);
}

/* 메인 메뉴: 버튼 가운데 정렬 */
#main-menu-panel .menu-button {
    width: 280px;
}

.menu-button--small {
    min-width: 130px;
    font-size: 12px;
    height: 38px;
}

.menu-button--danger {
    color: rgb(220, 150, 150);
    background-color: rgb(34, 26, 28);
    border-color: rgba(200, 110, 110, 0.25);
}
.menu-button--danger:hover {
    background-color: rgb(48, 32, 34);
    border-color: rgba(200, 110, 110, 0.55);
}


/* === 텍스트 입력 === */

.text-input {
    height: 40px;
    margin-bottom: 18px;
    font-size: 14px;
    color: rgb(228, 230, 234);
}

.text-input .unity-text-field__input {
    color: rgb(228, 230, 234);
    background-color: rgb(18, 22, 28);
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    border-width: 1px;
    padding: 0 12px;
    -unity-text-align: middle-left;
}

.text-input .unity-text-field__input:focus {
    border-color: rgba(180, 195, 215, 0.5);
}


/* === 스크롤 리스트 === */

.list-scroll {
    width: 100%;
    height: 280px;
    background-color: rgb(14, 16, 20);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    margin-bottom: 16px;
}

/* ScrollView 내부 스크롤바를 다크 톤으로 통일 */
.list-scroll .unity-scroller {
    background-color: transparent;
}

.list-scroll .unity-scroller--vertical {
    width: 8px;
}

.list-scroll .unity-scroller--horizontal {
    height: 8px;
}

.list-scroll .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 0;
}

.list-scroll .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 0;
    border-radius: 2px;
    min-width: 4px;
    min-height: 4px;
}

.list-scroll .unity-base-slider__dragger:hover {
    background-color: rgba(180, 195, 215, 0.5);
}

/* 스크롤바 위/아래 화살표 버튼 숨김 (선택사항: 미니멀하게) */
.list-scroll .unity-scroller__low-button,
.list-scroll .unity-scroller__high-button {
    display: none;
}


/* === 방 목록 항목 === */

.room-entry-button {
    width: 100%;
    height: 50px;
    font-size: 14px;
    color: rgb(228, 230, 234);
    background-color: transparent;
    border-width: 0;
    border-left-width: 2px;
    border-color: transparent;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
    border-radius: 0;
    margin: 0;
    padding: 0 20px;
    -unity-text-align: middle-left;
    letter-spacing: 1px;
    transition-duration: 80ms;
    transition-property: background-color, border-left-color;
}

.room-entry-button:hover {
    background-color: rgba(255, 255, 255, 0.04);
    border-left-color: rgb(180, 195, 215);
}

.room-entry-button:active {
    background-color: rgba(255, 255, 255, 0.07);
}


/* === 플레이어 목록 항목 === */

.player-entry {
    height: 44px;
    font-size: 14px;
    color: rgb(228, 230, 234);
    background-color: transparent;
    padding: 0 20px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    -unity-text-align: middle-left;
    letter-spacing: 1px;
}


/* === 버튼 행 === */

.button-row {
    flex-direction: row;
    justify-content: flex-end;
    width: 100%;
    margin-top: 8px;
}

.button-row > .menu-button {
    min-width: 140px;
    margin-left: 8px;
    margin-right: 0;
}


/* === 방 인원 수 === */

.room-count {
    color: rgba(170, 180, 195, 0.7);
    font-size: 12px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}


/* === 강화 화면 === */

.upgrade-gold-label {
    color: rgb(218, 180, 110);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.upgrade-scroll {
    height: 320px;
}

.upgrade-entry {
    flex-direction: row;
    align-items: center;
    padding: 14px 18px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.upgrade-entry__info {
    flex-grow: 1;
    flex-direction: column;
}

.upgrade-entry__name {
    color: rgb(228, 230, 234);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.upgrade-entry__desc {
    color: rgba(170, 180, 195, 0.7);
    font-size: 12px;
    margin-top: 4px;
}

.upgrade-entry__level {
    color: rgba(180, 195, 215, 0.85);
    font-size: 13px;
    -unity-font-style: bold;
    width: 80px;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.upgrade-entry__button {
    min-width: 110px;
    height: 36px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(228, 230, 234);
    background-color: rgb(32, 38, 46);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    margin-left: 12px;
    padding: 0 14px;
}

.upgrade-entry__button:hover {
    background-color: rgb(44, 52, 62);
    border-color: rgba(180, 195, 215, 0.45);
}

.upgrade-entry__button:disabled {
    background-color: rgb(24, 28, 34);
    color: rgba(120, 130, 145, 0.4);
    border-color: rgba(255, 255, 255, 0.05);
}

.upgrade-entry__button--maxed {
    color: rgb(218, 180, 110);
    background-color: rgb(34, 30, 22);
    border-color: rgba(218, 180, 110, 0.3);
}
