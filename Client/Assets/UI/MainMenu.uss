/* === MainMenu === */

.main-menu-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    align-items: center;
    justify-content: center;
}

.start-button {
    width: 200px;
    height: 60px;
    font-size: 24px;
    color: white;
    background-color: rgb(50, 120, 220);
    border-width: 2px;
    border-color: rgb(100, 180, 255);
    border-radius: 8px;
}

.start-button:hover {
    background-color: rgb(70, 150, 250);
}

.start-button:active {
    background-color: rgb(30, 90, 180);
}
