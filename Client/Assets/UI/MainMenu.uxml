<ui:UXML xmlns:ui="UnityEngine.UIElements">

    <!-- Main Menu -->
    <ui:VisualElement name="main-menu-panel" class="full-panel">
        <ui:Label text="SUBWAY STATION SURVIVAL" class="game-title" />
        <ui:Button name="play-button" text="PLAY" class="menu-button" />
    </ui:VisualElement>

    <!-- Name Input -->
    <ui:VisualElement name="name-input-panel" class="full-panel" style="display: none;">
        <ui:VisualElement class="dialog-box">
            <ui:Label text="ENTER NAME" class="dialog-title" />
            <ui:TextField name="name-field" class="text-input" />
            <ui:Button name="connect-button" text="CONNECT" class="menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Room List -->
    <ui:VisualElement name="room-list-panel" class="full-panel" style="display: none;">
        <ui:VisualElement class="dialog-box dialog-box--wide">
            <ui:Label text="ROOM LIST" class="dialog-title" />
            <ui:ScrollView name="room-scroll" class="list-scroll" />
            <ui:VisualElement class="button-row">
                <ui:Button name="refresh-button"     text="REFRESH"     class="menu-button menu-button--small" />
                <ui:Button name="create-room-button" text="CREATE ROOM"  class="menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Create Room -->
    <ui:VisualElement name="create-room-panel" class="full-panel" style="display: none;">
        <ui:VisualElement class="dialog-box">
            <ui:Label text="CREATE ROOM" class="dialog-title" />
            <ui:TextField name="room-name-field" class="text-input" />
            <ui:VisualElement class="button-row">
                <ui:Button name="cancel-create-button"  text="CANCEL" class="menu-button menu-button--danger" />
                <ui:Button name="confirm-create-button" text="CREATE"  class="menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Waiting Room -->
    <ui:VisualElement name="waiting-room-panel" class="full-panel" style="display: none;">
        <ui:VisualElement class="dialog-box dialog-box--wide">
            <ui:Label name="room-name-label"  text="WAITING ROOM" class="dialog-title" />
            <ui:Label name="room-count-label" text="0 / 4"        class="room-count" />
            <ui:ScrollView name="player-scroll" class="list-scroll" />
            <ui:VisualElement class="button-row">
                <ui:Button name="leave-room-button"  text="LEAVE"      class="menu-button menu-button--danger" />
                <ui:Button name="start-game-button"  text="START GAME" class="menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Character Select Modal -->
    <ui:VisualElement name="character-select-modal" class="full-panel modal-overlay" style="display: none;">
        <ui:VisualElement class="dialog-box dialog-box--wide">
            <ui:Label text="SELECT CHARACTER" class="dialog-title" />
            <ui:VisualElement class="char-select-content">
                <ui:ScrollView name="char-select-grid" class="char-select-grid" />
                <ui:VisualElement name="char-select-detail" class="char-select-detail">
                    <ui:VisualElement name="char-preview" class="char-preview"/>
                    <ui:Label name="char-detail-name"  text="Select a character" class="char-detail-name" />
                    <ui:Label name="char-detail-stats" text=""                   class="char-detail-stats" />
                    <ui:Label name="char-detail-desc"  text=""                   class="char-detail-desc" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="button-row">
                <ui:Button name="char-select-cancel"  text="CANCEL"  class="menu-button menu-button--danger" />
                <ui:Button name="char-select-confirm" text="CONFIRM" class="menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
