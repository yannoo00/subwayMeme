.hud-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

.hud-panel {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 8px;
    padding: 8px 12px;
    min-width: 160px;
}

.hud-panel--hidden {
    display: none;
}

/* HP 패널: 왼쪽 상단 */
#hp-panel {
    top: 16px;
    left: 16px;
}

/* 타이머 패널: 오른쪽 상단 */
#timer-panel {
    top: 16px;
    right: 16px;
    align-items: flex-end;
}

.hud-label--title {
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    margin-bottom: 4px;
}

.hud-label {
    color: white;
    font-size: 13px;
    margin-top: 4px;
}

.hud-label--timer {
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
}

/* HP 바 */
.hp-bar-bg {
    width: 160px;
    height: 8px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

.hp-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(80, 200, 80);
    border-radius: 4px;
    /* width는 코드에서 퍼센트로 설정 */
}


/* === 우하단 column 컨테이너 (ammo + weapon 묶음) === */

.bottom-right {
    position: absolute;
    bottom: 16px;
    right: 16px;
    flex-direction: column;
    align-items: flex-end;
}


/* === 무기 슬롯 패널 === */

.weapon-panel {
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 8px;
    padding: 6px;
}

.weapon-slot {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 6px;
    border-color: rgba(255, 255, 255, 0.0);
    border-width: 2px;
    padding: 6px 12px;
    margin-left: 4px;
    margin-right: 4px;
    min-width: 110px;
}

/* 활성 슬롯 강조 - 테두리 + 배경 밝기 */
.weapon-slot--active {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.85);
}

.weapon-slot__key {
    color: rgba(255, 255, 255, 0.75);
    font-size: 14px;
    -unity-font-style: bold;
    margin-right: 8px;
    min-width: 12px;
}

.weapon-slot__name {
    color: white;
    font-size: 13px;
}

/* 빈 슬롯: 이름 텍스트 dim 처리 */
.weapon-slot--empty .weapon-slot__name {
    color: rgba(255, 255, 255, 0.35);
    -unity-font-style: italic;
}


/* === 탄약 패널 === */

.ammo-panel {
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 8px;
    padding: 8px 14px;
    margin-bottom: 8px;
    align-items: flex-end;
    min-width: 120px;
}

.ammo-status {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
}

/* 재장전 진행률 바 */
.reload-bar-bg {
    width: 120px;
    height: 6px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    margin-top: 6px;
}

.reload-bar-fill {
    height: 100%;
    width: 0;
    background-color: rgb(255, 200, 50);
    border-radius: 3px;
    /* width는 코드에서 매 프레임 퍼센트로 설정 */
}


/* === 크로스헤어 (화면 정중앙, 작은 십자) === */

.crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    margin-top: -7px;
}

/* 가로 막대 */
.crosshair__h {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    margin-top: -1px;
    background-color: rgba(255, 255, 255, 0.85);
}

/* 세로 막대 */
.crosshair__v {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background-color: rgba(255, 255, 255, 0.85);
}
