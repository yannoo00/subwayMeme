/* === COLOR TOKENS ===
   bg-darkest:    rgb(20, 20, 20)
   bg-panel:      rgb(42, 42, 42)
   bg-surface:    rgb(58, 58, 58)
   bg-surface-hov:rgb(72, 72, 72)
   bg-inset:      rgb(30, 30, 30)
   border:        rgba(160, 160, 160, 0.35)
   border-strong: rgba(200, 200, 160, 0.55)
   text:          rgb(210, 210, 205)
   text-dim:      rgba(155, 155, 148, 0.8)
   text-muted:    rgba(120, 118, 112, 0.6)
   accent:        rgb(218, 175, 50)
   health:        rgb(85, 170, 85)
   stamina:       rgb(85, 145, 195)
*/


.damage-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-image-tint-color: rgba(255, 0, 0, 0);
}

.hud-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

.hud-panel {
    position: absolute;
    background-color: rgb(42, 42, 42);
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(160, 160, 160, 0.35);
    padding: 10px 14px;
    min-width: 180px;
}

.hud-panel--hidden { display: none; }

#hp-panel    { top: 20px; left: 20px; }
#timer-panel {
    top: 20px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
}
#spectator-panel {
    bottom: 30px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
}


/* === LABEL HIERARCHY === */

.hud-label--title {
    color: rgba(155, 155, 148, 0.8);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 6px;
}

.hud-label {
    color: rgb(210, 210, 205);
    font-size: 12px;
    margin-top: 6px;
    letter-spacing: 1px;
}

.hud-label--timer {
    color: rgb(218, 175, 50);
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}


/* === HP BAR === */

.hp-bar-bg {
    width: 180px;
    height: 5px;
    background-color: rgb(30, 30, 30);
    border-radius: 0;
}

.hp-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(85, 170, 85);
    border-radius: 0;
}


/* === STAMINA BAR === */

.stamina-title {
    margin-top: 10px;
}

.stamina-bar-bg {
    width: 180px;
    height: 5px;
    background-color: rgb(30, 30, 30);
    border-radius: 0;
}

.stamina-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(85, 145, 195);
    border-radius: 0;
}


/* === BOTTOM RIGHT COLUMN === */

.bottom-right {
    position: absolute;
    bottom: 20px;
    right: 20px;
    flex-direction: column;
    align-items: flex-end;
}


/* === WEAPON SLOTS === */

.weapon-panel {
    flex-direction: row;
    background-color: rgb(42, 42, 42);
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(160, 160, 160, 0.35);
    padding: 6px;
}

.weapon-slot {
    flex-direction: row;
    align-items: center;
    background-color: rgb(30, 30, 30);
    border-width: 1px;
    border-color: rgba(160, 160, 160, 0.2);
    border-radius: 0;
    padding: 8px 14px;
    margin-left: 4px;
    margin-right: 4px;
    min-width: 130px;
}

.weapon-slot--active {
    background-color: rgb(52, 48, 30);
    border-color: rgba(218, 175, 50, 0.6);
}

.weapon-slot__key {
    color: rgba(155, 155, 148, 0.65);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-right: 10px;
    min-width: 12px;
}

.weapon-slot--active .weapon-slot__key {
    color: rgb(218, 175, 50);
}

.weapon-slot__name {
    color: rgb(210, 210, 205);
    font-size: 12px;
    letter-spacing: 1px;
}

.weapon-slot--empty .weapon-slot__name {
    color: rgba(120, 118, 112, 0.5);
    -unity-font-style: italic;
}


/* === AMMO PANEL === */

.ammo-panel {
    background-color: rgb(42, 42, 42);
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(160, 160, 160, 0.35);
    padding: 10px 16px;
    margin-bottom: 10px;
    align-items: flex-end;
    min-width: 130px;
}

.ammo-status {
    color: rgb(210, 210, 205);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.reload-bar-bg {
    width: 130px;
    height: 3px;
    background-color: rgb(30, 30, 30);
    border-radius: 0;
    margin-top: 8px;
}

.reload-bar-fill {
    height: 100%;
    width: 0;
    background-color: rgb(218, 175, 50);
    border-radius: 0;
}


/* === GAME RESULT PANEL === */

.game-result-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.82);
    align-items: center;
    justify-content: center;
}

.result-title {
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    -unity-text-align: middle-center;
    color: rgb(210, 210, 205);
}

.result-title--clear {
    color: rgb(85, 170, 85);
}

.result-title--over {
    color: rgb(195, 75, 75);
}

.result-button {
    margin-top: 50px;
    padding: 14px 32px;
    background-color: rgb(42, 42, 42);
    border-width: 1px;
    border-color: rgba(200, 200, 160, 0.55);
    color: rgb(210, 210, 205);
    font-size: 16px;
    letter-spacing: 4px;
    border-radius: 0;
    -unity-font-style: bold;
}

.result-button:hover {
    background-color: rgb(58, 58, 58);
    border-color: rgb(218, 175, 50);
    color: rgb(218, 175, 50);
}

.result-button:active {
    background-color: rgb(30, 30, 30);
}


/* === CROSSHAIR === */

.crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    margin-top: -6px;
}

.crosshair__h {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    margin-top: -1px;
    background-color: rgba(210, 210, 205, 0.8);
}

.crosshair__v {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    margin-left: -1px;
    background-color: rgba(210, 210, 205, 0.8);
}
