/* === 컬러 토큰 (참고) ===
   bg-panel:    rgba(18, 22, 28, 0.85)
   bg-track:    rgba(255, 255, 255, 0.07)
   border:      rgba(255, 255, 255, 0.08)
   text:        rgb(228, 230, 234)
   text-dim:    rgba(170, 180, 195, 0.7)
   text-muted:  rgba(120, 130, 145, 0.5)
   accent:      rgb(180, 195, 215)
   health:      rgb(140, 185, 145)
   gold:        rgb(218, 180, 110)
*/


.hud-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

.hud-panel {
    position: absolute;
    background-color: rgba(18, 22, 28, 0.85);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 10px 14px;
    min-width: 180px;
}

.hud-panel--hidden { display: none; }

#hp-panel    { top: 20px; left: 20px; }
#timer-panel {
    top: 20px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
}


/* === 라벨 위계 === */

.hud-label--title {
    color: rgba(170, 180, 195, 0.7);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 6px;
}

.hud-label {
    color: rgb(228, 230, 234);
    font-size: 12px;
    margin-top: 6px;
    letter-spacing: 1px;
}

.hud-label--timer {
    color: rgb(228, 230, 234);
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}


/* === HP 바 === */

.hp-bar-bg {
    width: 180px;
    height: 5px;
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 1px;
}

.hp-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(140, 185, 145);
    border-radius: 1px;
}


/* === 우하단 column (탄약 + 무기 슬롯) === */

.bottom-right {
    position: absolute;
    bottom: 20px;
    right: 20px;
    flex-direction: column;
    align-items: flex-end;
}


/* === 무기 슬롯 패널 === */

.weapon-panel {
    flex-direction: row;
    background-color: rgba(18, 22, 28, 0.85);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 6px;
}

.weapon-slot {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    border-radius: 2px;
    padding: 8px 14px;
    margin-left: 4px;
    margin-right: 4px;
    min-width: 130px;
}

.weapon-slot--active {
    background-color: rgba(180, 195, 215, 0.1);
    border-color: rgba(180, 195, 215, 0.5);
}

.weapon-slot__key {
    color: rgba(170, 180, 195, 0.65);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-right: 10px;
    min-width: 12px;
}

.weapon-slot--active .weapon-slot__key {
    color: rgb(180, 195, 215);
}

.weapon-slot__name {
    color: rgb(228, 230, 234);
    font-size: 12px;
    letter-spacing: 1px;
}

.weapon-slot--empty .weapon-slot__name {
    color: rgba(120, 130, 145, 0.5);
    -unity-font-style: italic;
}


/* === 탄약 패널 === */

.ammo-panel {
    background-color: rgba(18, 22, 28, 0.85);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 10px 16px;
    margin-bottom: 10px;
    align-items: flex-end;
    min-width: 130px;
}

.ammo-status {
    color: rgb(228, 230, 234);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.reload-bar-bg {
    width: 130px;
    height: 3px;
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 1px;
    margin-top: 8px;
}

.reload-bar-fill {
    height: 100%;
    width: 0;
    background-color: rgb(218, 180, 110);
    border-radius: 1px;
}


/* === 크로스헤어 === */

.crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    margin-top: -6px;
}

.crosshair__h {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    margin-top: -1px;
    background-color: rgba(228, 230, 234, 0.8);
}

.crosshair__v {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    margin-left: -1px;
    background-color: rgba(228, 230, 234, 0.8);
}
