.hud-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

.hud-panel {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 8px;
    padding: 8px 12px;
    min-width: 160px;
}

.hud-panel--hidden {
    display: none;
}

/* HP 패널: 왼쪽 상단 */
#hp-panel {
    top: 16px;
    left: 16px;
}

/* 타이머 패널: 오른쪽 상단 */
#timer-panel {
    top: 16px;
    right: 16px;
    align-items: flex-end;
}

.hud-label--title {
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    margin-bottom: 4px;
}

.hud-label {
    color: white;
    font-size: 13px;
    margin-top: 4px;
}

.hud-label--timer {
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
}

/* HP 바 */
.hp-bar-bg {
    width: 160px;
    height: 8px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

.hp-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(80, 200, 80);
    border-radius: 4px;
    /* width는 코드에서 퍼센트로 설정 */
}